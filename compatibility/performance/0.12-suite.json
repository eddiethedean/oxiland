{
  "schema_version": 1,
  "id": "oxiland-redland-0.12-v1",
  "status": "frozen",
  "baseline": "Redland librdf 1.0.17",
  "surface": "public C API",
  "thresholds": {
    "throughput_oxiland_over_redland_min": 0.90,
    "latency_oxiland_over_redland_max": 1.20,
    "throughput_ci_lower_min": 0.85,
    "latency_ci_upper_max": 1.40,
    "confidence": 0.95,
    "bootstrap_rounds": 10000,
    "minimum_samples": 40
  },
  "protocol": {
    "require_production_compile": true,
    "optimization": "Cargo --release (profile release) for Oxiland; equivalent native -O2 or better for Redland and C harness wrappers",
    "cargo": {
      "profile": "release",
      "required_flags": ["--release", "--locked"],
      "forbidden_profiles": ["dev", "test", "bench"],
      "debug_assertions": false,
      "artifact_dir": "target/release",
      "notes": "Rust performance is compile-mode dependent. Debug/dev builds are invalid evidence. Do not use cargo run without --release, target/debug libraries, or RUSTFLAGS that force opt-level=0."
    },
    "c_harness": {
      "oxiland_library": "packaged from cargo build -p oxiland-capi --release --locked",
      "wrapper_flags": "at least -O2 -Wall -Werror, matched for Redland and Oxiland perf_bench binaries",
      "redland": "system or pinned librdf built with the matrix-declared native optimization"
    },
    "order": "alternating AB/BA after recorded warm-up",
    "cache_modes": [
      "warm",
      "cold where named by case"
    ],
    "validation": "every iteration validates the completed RDF result",
    "isolation": "same host, storage medium, allocator policy, thread limit, and input bytes"
  },
  "cases": [
    {
